{
  "name": "hostelerp-desktop",
  "version": "1.0.0",
  "description": "HostelERP Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": ["hostelerp", "electron", "desktop"],
  "author": "HostelERP Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.hostelerp.desktop",
    "productName": "HostelERP",
    "protocols": [
      {
        "name": "HostelERP Protocol",
        "schemes": ["hostelerp"]
      }
    ],
    "win": {
      "target": ["nsis", "msi"],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "license": "license.txt",
      "installerIcon": "assets/icon.png",
      "uninstallerIcon": "assets/icon.png",
      "uninstallDisplayName": "HostelERP",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HostelERP"
    },
    "mac": {
      "target": ["dmg", "pkg"],
      "icon": "assets/icon.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": ["deb", "AppImage"],
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  }
}
