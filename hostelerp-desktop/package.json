{
  "name": "hostelerp-desktop",
  "version": "1.0.9",
  "description": "HostelERP Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": ["hostelerp", "electron", "desktop"],
  "author": "HostelERP Team <admin@hostelerp.com>",
  "repository": "https://github.com/arpitchaudhary14/HostelERP",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "publish": ["github"],
    "appId": "com.hostelerp.desktop",
    "productName": "HostelERP",
    "protocols": [
      {
        "name": "HostelERP Protocol",
        "schemes": ["hostelerp"]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64", "ia32", "arm64"] },
        { "target": "portable", "arch": ["x64", "ia32"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "license": "license.txt",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "uninstallDisplayName": "HostelERP",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HostelERP"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        { "target": "deb", "arch": ["x64", "arm64"] },
        { "target": "AppImage", "arch": ["x64", "arm64"] }
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  }
}
